APP_NAME="Merter Giyim"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul
APP_URL=https://HESAP_ADI.alwaysdata.net

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Alwaysdata paneli > Databases > MySQL (servis MariaDB'dir, driver da mariadb)
DB_CONNECTION=mariadb
DB_HOST=mysql-HESAP_ADI.alwaysdata.net
DB_PORT=3306
DB_DATABASE=HESAP_ADI_mertergiyim
DB_USERNAME=HESAP_ADI
DB_PASSWORD=

# Veritabanındaki mevcut ürün görselleri Supabase Storage'da duruyor;
# bu adres boş kalırsa eski görseller kırılır.
SUPABASE_STORAGE_URL=https://whcylakuagonefgjdqhx.supabase.co/storage/v1/object/public

STOREFRONT_PLACEHOLDER_IMAGE=
STOREFRONT_WHATSAPP_NUMBER=905323259788
STOREFRONT_SITE_URL=https://HESAP_ADI.alwaysdata.net
STOREFRONT_CACHE_TTL=3600
# Ürünlerde varsayılan paket (seri) adedi
STOREFRONT_PACK_DEFAULT_SIZE=1

# Sipariş bildirimi Telegram bot API ile gidiyor (WhatsApp Cloud API kaldırıldı).
# İkisi de boşsa bildirim sessizce atlanır, sipariş normal kaydedilir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ürün ve galeri dosyaları storage/app/public altında kalır.
STOREFRONT_UPLOAD_DISK=local
STOREFRONT_PRODUCTS_DIRECTORY=product-images
STOREFRONT_SITE_DIRECTORY=site-media
STOREFRONT_UPLOAD_MAX_SIZE=1600
STOREFRONT_UPLOAD_QUALITY=80

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=merter_giyim_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
