APP_NAME="Merter Giyim"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost:8090

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Veritabanı (lokal ve canlı: MariaDB) ---
# Canlıda (alwaysdata) DB_HOST mysql-<hesap>.alwaysdata.net biçimindedir.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mertergiyim
DB_USERNAME=
DB_PASSWORD=

# --- Vitrin ---
# Ürün/site görselleri Supabase Storage'da; boşsa yerel disk kullanılır.
SUPABASE_STORAGE_URL=
STOREFRONT_PLACEHOLDER_IMAGE=
STOREFRONT_WHATSAPP_NUMBER=905323259788
STOREFRONT_SITE_URL=http://localhost:8090
STOREFRONT_CACHE_TTL=3600

# Yeni ürün açılırken önerilen paket (seri) adedi. Beden dağılımı kalıpları
# config/storefront.php içindeki 'pack.templates' listesinden gelir.
STOREFRONT_PACK_DEFAULT_SIZE=5

# --- Sipariş bildirimi (Telegram Bot API) ---
# Boş bırakılırsa sipariş normal kaydedilir, bildirim gönderilmez ve panelde
# "Gönderilmedi" olarak görünür.
# 1) @BotFather'a /newbot yazıp bot token alın.
# 2) Bildirimlerin gideceği kişi/grubu bot ile bir kez etkileşime sokup chat id'sini alın
#    (grup ise -100... ile başlar). Chat id env yerine panel > Site Ayarları'ndan da girilebilir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Admin paneli / Gemini çevirisi ---
GEMINI_API_KEY=
# Sunucu IP'si Gemini tarafından engelleniyorsa vekil adres (boşsa doğrudan Google)
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Görsel yükleme (Alwaysdata kalıcı disk) ---
STOREFRONT_UPLOAD_DISK=local
STOREFRONT_PRODUCTS_DIRECTORY=products
STOREFRONT_SITE_DIRECTORY=site
STOREFRONT_UPLOAD_MAX_SIZE=1600
STOREFRONT_UPLOAD_QUALITY=80

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
