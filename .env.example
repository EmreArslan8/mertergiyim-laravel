APP_NAME="Merter Giyim"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost:8090

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Veritabanı ---
# Lokal geliştirme: SQLite (database/database.sqlite)
DB_CONNECTION=sqlite

# Canlı: Supabase Postgres. Şifre alındığında doldurup
# DB_CONNECTION=pgsql_supabase yapmak yeterli.
SUPABASE_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=postgres.whcylakuagonefgjdqhx
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# --- Vitrin ---
SUPABASE_STORAGE_URL=https://whcylakuagonefgjdqhx.supabase.co/storage/v1/object/public
STOREFRONT_PLACEHOLDER_IMAGE=
STOREFRONT_WHATSAPP_NUMBER=905323259788
STOREFRONT_SITE_URL=https://www.mertergiyim.com
STOREFRONT_CACHE_TTL=3600

# --- Admin paneli / Gemini çevirisi ---
SUPABASE_URL=https://whcylakuagonefgjdqhx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Görsel yükleme (Supabase Storage, S3 uyumlu) ---
# Anahtarlar Supabase Dashboard -> Storage -> S3 access keys'ten üretilir.
# Anahtarlar girildikten sonra FILESYSTEM_SUPABASE_DISK=supabase yapılır;
# boş/varsayılan halde yüklemeler lokal yedek diske düşer.
FILESYSTEM_SUPABASE_DISK=local_supabase_stub
SUPABASE_S3_ENDPOINT=https://whcylakuagonefgjdqhx.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-central-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
STOREFRONT_UPLOAD_MAX_SIZE=1600
STOREFRONT_UPLOAD_QUALITY=80

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
