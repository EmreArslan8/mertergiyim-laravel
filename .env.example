APP_NAME="Merter Giyim"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost:8090

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Yerel veritabanı ---
DB_CONNECTION=sqlite

# --- Vitrin ---
STOREFRONT_PLACEHOLDER_IMAGE=
STOREFRONT_WHATSAPP_NUMBER=905323259788
STOREFRONT_SITE_URL=http://localhost:8090
STOREFRONT_CACHE_TTL=3600

# --- Sipariş bildirimi (Meta WhatsApp Cloud API) ---
# Boş bırakılırsa sipariş normal kaydedilir, bildirim gönderilmez ve panelde
# "Gönderilmedi" olarak görünür. Değerler Meta for Developers -> WhatsApp'tan alınır.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Bildirimin gideceği numara; boşsa STOREFRONT_WHATSAPP_NUMBER kullanılır.
WHATSAPP_NOTIFY_NUMBER=
# template = onaylı şablonla gönder (önerilen), text = düz metin (24 saat kuralına takılır)
WHATSAPP_MESSAGE_MODE=template
WHATSAPP_TEMPLATE_NAME=yeni_siparis
WHATSAPP_TEMPLATE_LANGUAGE=tr

# --- Admin paneli / Gemini çevirisi ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Görsel yükleme (Alwaysdata kalıcı disk) ---
STOREFRONT_UPLOAD_DISK=local
STOREFRONT_PRODUCTS_DIRECTORY=products
STOREFRONT_SITE_DIRECTORY=site
STOREFRONT_UPLOAD_MAX_SIZE=1600
STOREFRONT_UPLOAD_QUALITY=80

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
